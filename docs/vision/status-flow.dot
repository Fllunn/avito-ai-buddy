digraph Status {
  graph [rankdir=TB, bgcolor="transparent", pad=0.12, nodesep=0.28, ranksep=0.28, fontname="Arial", label="Состояние одной сервисной попытки", labelloc=t, fontsize=19, fontcolor="#17243d"];
  node [shape=box, style="rounded,filled", color="#cbd8ec", penwidth=1.1, fontname="Arial", fontsize=14, fontcolor="#17243d", margin="0.17,0.11", width=2.3];
  edge [color="#829ac3", arrowsize=0.7, penwidth=1.3, fontname="Arial", fontsize=11];
  draft [fillcolor="#fff1df", label="Карточка подтверждена\nПрава проверены"];
  attempt [fillcolor="#edf2ff", label="Попытка записана\nдо вызова"];
  done [fillcolor="#e8f7f4", label="Успех сохранён\nНомер и статус показаны"];
  reject [fillcolor="#fff1df", label="Сервис отказал\nПричина показана"];
  unknown [fillcolor="#fbecef", label="Исход неизвестен\nПовтор закрыт"];
  resolve [fillcolor="#edf2ff", label="Сверка по попытке\n→ подтверждённый статус"];
  draft -> attempt;
  attempt -> {done reject unknown};
  unknown -> resolve;
  {rank=same; done; reject; unknown;}
}
