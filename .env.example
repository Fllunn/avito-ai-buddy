# Пример для локальной разработки. Данные и режим демонстрационные.
DEMO_MODE=true
DEMO_NOW=2026-11-12T12:00:00+05:00
DEMO_TIMEZONE=Asia/Yekaterinburg
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://buddy_api:replace-local-api-demo-password@localhost:15432/buddy_api
REDIS_ADDR=localhost:16379
ALLOWED_ORIGIN=http://localhost:5173
MOCK_URL=http://localhost:8081
# Заменить локальным значением минимум 32 байта; общий для API и имитаций.
SERVICE_SECRET=replace-with-local-demo-value-32-bytes
LLM_PROVIDER=fake
LLM_MODEL=
CARD_TTL=24h
STEP_CONFIRMATION_TTL=5m
SESSION_TTL=8h
LLM_TIMEOUT=20s
SERVICE_TIMEOUT=3s
CLIENT_POLL_INTERVAL=1s
RECONCILE_DELAYS=1s,3s,10s,30s,60s

# Только демонстрационные примеры. Для локального .env задать свои значения.
# API_DB_PASSWORD/MOCKS_DB_PASSWORD: использовать буквы, цифры, дефис, подчёркивание (подставляются в URL).
POSTGRES_PASSWORD=replace-local-postgres-demo-password
API_DB_PASSWORD=replace-local-api-demo-password
MOCKS_DB_PASSWORD=replace-local-mocks-demo-password

# Отдельная идентичность ведущего, не SERVICE_SECRET и не пользовательская cookie.
DEMO_ADMIN_SECRET=replace-with-presenter-demo-value-32-bytes
DEMO_PANEL_ORIGIN=http://localhost:8081
# Для LLM_PROVIDER=openrouter укажи модель и ключ только на сервере.
OPENROUTER_API_KEY=
# VITE_API_BASE_URL задаётся на этапе сборки frontend при отдельном origin API.
